{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "node.schema.json",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "geometry": {
      "$ref": "geometry.schema.json"
    },
    "transform": {
      "type": "object"
    },
    "appearance": {
      "type": "object"
    },
    "interaction": {
      "type": "object"
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "type",
    "geometry"
  ],
  "additionalProperties": true
}
